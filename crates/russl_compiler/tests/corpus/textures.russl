struct VsOut {
    #[builtin(position)] pos: Vec4,
    #[location(0)] uv: Vec2,
}

#[group(0)] #[binding(0)] static ATLAS: Texture2D<f32>;
#[group(0)] #[binding(1)] static SAMPLER: Sampler;
#[group(1)] #[binding(0)] static IDS: Texture2D<u32>;

#[vertex]
fn vs(#[location(0)] pos: Vec2, #[location(1)] uv: Vec2) -> VsOut {
    VsOut { pos: Vec4::new(pos, 0.0, 1.0), uv }
}

#[fragment]
#[location(0)]
fn fs(input: VsOut) -> Vec4 {
    let size = ATLAS.dimensions().as_vec2();
    let id = IDS.load(IVec2::ZERO, 0).x;
    let coverage = ATLAS.sample_level(SAMPLER, input.uv / size, 0.0).x;
    if coverage < coverage.fwidth() {
        discard!();
    }
    Vec4::new(coverage, ATLAS.sample(SAMPLER, input.uv).y, id as f32, 1.0)
}
